#include<stdio.h>
#include<string.h>
#define max 100
void push(char);
char pop();
char stack[max];
int top=-1;
int main()
{
   char s[max];
   int i=0;
   char x;
   printf("enter string");
   scanf("%s",s);
   while(s[i]!='\0')
   {
    push(s[i]);
    i++;
   }
   while(top!=-1)
   {
    x=pop();
    printf("%c",x);
   }
   return 0;

}
void push(char ch)
{
    top++;
    stack[top]=ch;
}
char pop()
    {
        int x;
        x=stack[top];
        top--;
        return(x);
    }
