#include <stdio.h>
#include <string.h>
# define max 100
int stack [max];
int top=-1;
int * ptr=NULL;
void push (int[]  ,int*);
void pop(int[],int*);
void peek(int[] ,int*);
void display(int[],int);
int main()
{
    int ch;
    do
  {
   printf("enter 1 for push \n 2 for pop\n 3 for peek\n and 4 for display \nand 5 for exit\n ");
    scanf("%d",&ch);
    switch(ch)
    {
        case 1:
        push(stack,&top);
        break;
        case 2:
        pop(stack,&top);
        break; 
        case 3:
        peek(stack,&top);
        break;
        case 4:
        display(stack,top);
        break;
        }
  }while(ch<=4);
  return 0;
}
void push(int stack[],int *ptr)
{
    int x;
    if(*ptr==max-1)
    {
        printf("stack overflow");
        
    }
    else
    {
        printf("enter a value");
        scanf("%d",&x);
        (*ptr)++;
        stack[*ptr]=x;
    }
}
void pop(int stack[],int *ptr)
{
    int x;
    if(*ptr==-1)
    {
        printf("stack underflow");
        
    }
    else
    {
    x=stack[*ptr];
    printf("popped value %d \n",x);
    (*ptr)--;
    }
}
void peek(int stack[],int *ptr)
{
    if(*ptr==-1)
    {
        printf("stack underflow");
        
    }
    else
    {
        printf("peek value %d \n",stack[*ptr]);
    }
}
void display(int stack[], int ptr)
{
    if(ptr == -1)
    {
        printf("stack underflow");
    }
    else
    {
        while(ptr >= 0)
        {
            printf("%d\n", stack[ptr]);
            (ptr)--;
        }
    }
}
