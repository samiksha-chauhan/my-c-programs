// Online C++ compiler to run C++ program online
#include <iostream>
#include<string>
#define max 100
void push(char);
char pop();
char stack[max];
int top=-1;
void push(char ch ){
    top++;
    stack[top]=ch;
}
char pop()
{
    char x;
    x=stack[top];
    top--;
    return (x);
}
void reverse()
{
    char x;
    if(top==-1)
    {
        return ;
    }
    else
    {
        x=pop();
        printf("%c",x);
        reverse();
    }
}
int main()
{
    int i =0;
    char s[max];
    printf("enter a string");
    scanf("%s",s);
    while(s[i]!='\0')
    {
     push(s[i]);
     i++;
    }
    reverse();
}
