#include<stdio.h>
#include<string.h>
#define max 100
void push(char );
char pop();
char stack[max];
int top=-1;
int main()
{
    char s[max];
    int i=0, count =0;
    char x;
    printf("enter string");
    scanf("%s",s);
    while(s[i]!='\0')
    {
        if(s[i]=='('||s[i]=='['||s[i]=='{')
        {
            push(s[i]);
        }
        else
        {
          x=pop();
          if(s[i]==')'&& x== '(' ||s[i]=='}' && x=='{'|| s[i]==']'&& x=='[')
          count=count+2;
        } 
        i++;
    }
    printf("count = %d",count);
    return 0;
}
void push(char ch)
{
    top ++;
    stack[top]=ch;
}
char pop ()
{
    char x;
    x=stack[top];
    top--;
    return (x);
}
